# Copy to deploy/.env on the server (never commit it). Read by `docker compose`.

# Image tag loaded with `docker load` (the server repo's git SHA).
SERVER_TAG=0000000

# Letters and digits only: it is embedded in DATABASE_URL. For example `openssl rand -hex 24`.
POSTGRES_PASSWORD=change-me

# PI Platform API base, without /v1.
PI_BASE_URL=https://id.pi.example

# Optional, defaults shown (plan §10: 1 GiB per actor, 100 MiB per file).
# ERPCONS_DB_MAX_CONNECTIONS=10
# ERPCONS_QUOTA_BYTES=1073741824
# ERPCONS_MAX_FILE_BYTES=104857600
# ERPCONS_TRUST_FORWARDED_FOR=true
# RUST_LOG=info,sqlx=warn
